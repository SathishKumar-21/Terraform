# Bootstrap uses LOCAL state on purpose: it creates the storage that every
# other stack keeps its state in (chicken-and-egg).
terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
}
